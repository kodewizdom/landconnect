{
  "expo": {
    "name": "LandConnect",
    "slug": "landconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.landconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2B26"
      },
      "package": "com.landconnect.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}